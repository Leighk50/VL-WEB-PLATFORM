:root{--black:#080808;--ink:#171512;--cream:#f5f0e7;--paper:#fffdf8;--gold:#b88a42;--muted:#726d64;--line:#ddd2c2;--max:1180px}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Arial,Helvetica,sans-serif;color:var(--ink);background:var(--paper);line-height:1.6}img{max-width:100%;display:block}a{color:inherit;text-decoration:none}.container{width:min(var(--max),calc(100% - 36px));margin:auto}.eyebrow{text-transform:uppercase;letter-spacing:.22em;font-size:.76rem;color:var(--gold);font-weight:700}.section{padding:82px 0}.section.alt{background:var(--cream)}h1,h2,h3{font-family:Georgia,'Times New Roman',serif;font-weight:500;line-height:1.08;margin:0 0 18px}h1{font-size:clamp(3rem,8vw,6.7rem)}h2{font-size:clamp(2.25rem,5vw,4rem)}h3{font-size:1.65rem}p{margin:0 0 18px}.lead{font-size:1.15rem;color:var(--muted);max-width:720px}.btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 24px;border:1px solid var(--gold);background:var(--gold);color:white;text-transform:uppercase;letter-spacing:.12em;font-size:.76rem;font-weight:700;transition:.2s}.btn:hover{transform:translateY(-2px);filter:brightness(.95)}.btn.outline{background:transparent;color:inherit;border-color:currentColor}.btn.dark{background:var(--black);border-color:var(--black)}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.site-header{position:fixed;inset:0 0 auto;z-index:50;background:linear-gradient(180deg,rgba(0,0,0,.82),transparent);color:#fff}.nav{height:92px;display:flex;align-items:center;justify-content:space-between;gap:24px}.brand img{height:72px;width:auto}.navlinks{display:flex;align-items:center;gap:24px;font-size:.78rem;text-transform:uppercase;letter-spacing:.12em}.navlinks a:hover{color:#e1bb7d}.menu-toggle{display:none;background:none;border:0;color:#fff;font-size:1.7rem}.hero{min-height:100vh;display:grid;place-items:center;position:relative;background:url('../images/hero.webp') center/cover no-repeat;color:white;text-align:center}.hero:before{content:'';position:absolute;inset:0;background:linear-gradient(rgba(0,0,0,.28),rgba(0,0,0,.72))}.hero-inner{position:relative;z-index:1;padding-top:90px}.hero .logo{width:min(520px,80vw);margin:0 auto 30px}.hero h1{max-width:970px;text-shadow:0 3px 30px #000}.hero p{font-size:1.15rem;max-width:700px;margin:0 auto}.hero .actions{justify-content:center}.three-grid,.card-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.feature-card{min-height:480px;position:relative;overflow:hidden;color:white;display:flex;align-items:flex-end;padding:32px;background-size:cover;background-position:center}.feature-card:before{content:'';position:absolute;inset:0;background:linear-gradient(transparent 20%,rgba(0,0,0,.8))}.feature-card>*{position:relative;z-index:1}.split{display:grid;grid-template-columns:1.05fr .95fr;gap:64px;align-items:center}.split img{width:100%;min-height:500px;object-fit:cover}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.card{background:white;border:1px solid var(--line);overflow:hidden}.card img{height:245px;width:100%;object-fit:cover}.card-body{padding:26px}.meta{font-size:.8rem;letter-spacing:.1em;text-transform:uppercase;color:var(--gold);font-weight:700}.page-hero{padding:180px 0 90px;background:var(--black);color:#fff;text-align:center}.page-hero p{max-width:700px;margin:auto;color:#d7d0c5}.booking-shell{background:#fff;border:1px solid var(--line);box-shadow:0 20px 60px rgba(0,0,0,.08);padding:30px;min-height:420px}.menu-list{display:grid;grid-template-columns:1fr 1fr;gap:18px 44px}.dish{padding:18px 0;border-bottom:1px solid var(--line)}.dish-row{display:flex;justify-content:space-between;gap:18px}.dish h3{font-family:Georgia,serif;font-size:1.2rem;margin:0}.price{font-weight:700;color:var(--gold)}.allergens{font-size:.78rem;color:var(--muted)}.notice{padding:18px 22px;background:#f5ead8;border-left:4px solid var(--gold)}.gallery{columns:3 280px;column-gap:18px}.gallery img{width:100%;margin:0 0 18px;break-inside:avoid}.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:46px}.footer{background:var(--black);color:#fff;padding:60px 0 28px}.footer-grid{display:grid;grid-template-columns:1.3fr 1fr 1fr;gap:42px}.footer img{width:230px}.footer small{color:#aaa}.footer a:hover{color:#d7ae6b}.footer-bottom{border-top:1px solid #333;margin-top:42px;padding-top:22px;color:#999}.sticky-book{position:fixed;right:18px;bottom:18px;z-index:60}.admin-note{background:#171512;color:white;padding:16px 20px;border-radius:8px}.tag{display:inline-block;border:1px solid var(--gold);color:var(--gold);padding:3px 8px;font-size:.68rem;text-transform:uppercase;letter-spacing:.1em;margin-right:5px}.room-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:26px}.room{position:relative}.room img{height:420px;width:100%;object-fit:cover}.room-info{position:absolute;inset:auto 20px 20px;background:rgba(0,0,0,.78);color:#fff;padding:20px}.coming{padding:70px 20px;text-align:center;border:1px dashed var(--gold);background:#fffaf2}@media(max-width:900px){.navlinks{position:fixed;inset:92px 0 auto;background:#080808;padding:24px;display:none;flex-direction:column;align-items:flex-start}.navlinks.open{display:flex}.menu-toggle{display:block}.nav .btn{display:none}.three-grid,.cards,.split,.contact-grid,.footer-grid,.room-grid{grid-template-columns:1fr}.feature-card{min-height:390px}.split img{min-height:360px}.menu-list{grid-template-columns:1fr}.section{padding:62px 0}.brand img{height:58px}.nav{height:78px}.navlinks{inset:78px 0 auto}.page-hero{padding-top:140px}.gallery{columns:2 180px}}@media(max-width:520px){.hero h1{font-size:3rem}.hero .actions .btn{width:100%}.booking-shell{padding:14px}.gallery{columns:1}.sticky-book{left:16px;right:16px}.sticky-book .btn{width:100%}}
