{
  "name": "village-limits-compliance-hub",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "migrate": "node dist-server/migrate.js",
    "migrate:dev": "tsx server/migrate.ts",
    "migrate-staging-data": "node dist-server/staging-data-migration-cli.js",
    "migrate-staging-data:dry-run": "node dist-server/staging-data-migration-cli.js --dry-run",
    "migrate-staging-data:verify": "node dist-server/staging-data-migration-cli.js --verify-only",
    "migrate-staging-data:dev": "tsx server/staging-data-migration-cli.ts",
    "create-admin": "node dist-server/create-admin.js",
    "storage:diagnostic": "node dist-server/storage-diagnostic.js",
    "start": "node dist-server/index.js"
  },
  "dependencies": {
    "@azure/identity": "^4.13.0",
    "@azure/storage-blob": "^12.29.1",
    "@vitejs/plugin-react": "latest",
    "bcryptjs": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "helmet": "latest",
    "jsonwebtoken": "latest",
    "mssql": "^12.2.0",
    "multer": "latest",
    "pdfjs-dist": "^5.4.624",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "vite": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/jsonwebtoken": "latest",
    "@types/mssql": "^9.1.9",
    "@types/multer": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/supertest": "latest",
    "concurrently": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "prettier": "^3.9.6",
    "supertest": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
